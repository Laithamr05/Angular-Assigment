# Copy to backend/.env and fill in. .env is git-ignored.
DB_URL=jdbc:postgresql://localhost:5432/products
DB_USERNAME=postgres
DB_PASSWORD=

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=

# User created on first startup, used to log in from the Angular app
DEMO_USERNAME=admin
DEMO_PASSWORD=
